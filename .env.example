# Local security-hardening mode. Copy this file to .env.local for localhost.
WISHES_STORAGE_MODE=mock
WISHES_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_WISHES_API_URL=/api/wishes

# Production-only values; never commit real values.
# GOOGLE_WISHES_SCRIPT_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
# GOOGLE_WISHES_WRITE_SECRET=generate-a-long-random-value
